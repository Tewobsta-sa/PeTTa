; Test suite for Graph Algorithms Library  
  
; Load the graph library  
!(import! &self (library lib_graph.metta))  
  
; Test 1: Basic graph creation and node addition  
(= (test-basic-creation)  
   (let* (($g (graph-create testgraph))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D)))  
         $g5))  
  
; Test 2: Edge addition  
(= (test-edge-addition)  
   (let* (($g (graph-create testgraph2))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-edge $g4 A B 1))  
          ($g6 (graph-add-edge $g5 B C 2))  
          ($g7 (graph-add-edge $g6 A C 5)))  
         $g7))  
  
; Test 3: Breadth-First Search  
(= (test-bfs)  
   (let* (($g (graph-create testgraph3))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 B C 1))  
          ($g8 (graph-add-edge $g7 C D 1))  
          ($g9 (graph-add-edge $g8 A D 10)))  
         (graph-bfs $g9 A D)))  
  
; Test 4: Depth-First Search  
(= (test-dfs)  
   (let* (($g (graph-create testgraph4))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 B C 1))  
          ($g8 (graph-add-edge $g7 C D 1))  
          ($g9 (graph-add-edge $g8 A D 10)))  
         (graph-dfs $g9 A D)))  
  
; Test 5: Dijkstra's shortest path  
(= (test-dijkstra)  
   (let* (($g (graph-create testgraph5))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 B C 1))  
          ($g8 (graph-add-edge $g7 C D 1))  
          ($g9 (graph-add-edge $g8 A D 10)))  
         (graph-dijkstra $g9 A D)))  
  
; Test 6: Connected components  
(= (test-connected-components)  
   (let* (($g (graph-create testgraph6))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 C D 1)))  
         (graph-connected-components $g7)))  
  
; Test 7: Graph connectivity check  
(= (test-is-connected)  
   (let* (($g (graph-create testgraph7))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-edge $g4 A B 1))  
          ($g6 (graph-add-edge $g5 B C 1)))  
         (graph-is-connected $g6)))  
  
; Test 8: Node neighbors  
(= (test-neighbors)  
   (let* (($g (graph-create testgraph8))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 A C 1))  
          ($g8 (graph-add-edge $g7 A D 1)))  
         (graph-neighbors $g8 A)))  
  
; Test 9: Node degree  
(= (test-degree)  
   (let* (($g (graph-create testgraph9))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-node $g4 D))  
          ($g6 (graph-add-edge $g5 A B 1))  
          ($g7 (graph-add-edge $g6 A C 1))  
          ($g8 (graph-add-edge $g7 A D 1)))  
         (graph-degree $g8 A)))  
  
; Test 10: Direct connection check  
(= (test-are-connected)  
   (let* (($g (graph-create testgraph10))  
          ($g2 (graph-add-node $g A))  
          ($g3 (graph-add-node $g2 B))  
          ($g4 (graph-add-node $g3 C))  
          ($g5 (graph-add-edge $g4 A B 1))  
          ($g6 (graph-add-edge $g5 B C 1)))  
         (graph-are-connected $g6 A C)))  
  
; Run all tests  
!(println "Running Graph Library Tests...")  
(= (run-tests)  
   (let* (($t1 (test-basic-creation))  
          ($t2 (test-edge-addition))  
          ($t3 (test-bfs))  
          ($t4 (test-dfs))  
          ($t5 (test-dijkstra))  
          ($t6 (test-connected-components))  
          ($t7 (test-is-connected))  
          ($t8 (test-neighbors))  
          ($t9 (test-degree))  
          ($t10 (test-are-connected)))  
         (println "Test 1:" $t1)  
         (println "Test 2:" $t2)  
         (println "Test 3:" $t3)  
         (println "Test 4:" $t4)  
         (println "Test 5:" $t5)  
         (println "Test 6:" $t6)  
         (println "Test 7:" $t7)  
         (println "Test 8:" $t8)  
         (println "Test 9:" $t9)  
         (println "Test 10:" $t10)  
         (println "All tests completed!")))  
  
!(run-tests)